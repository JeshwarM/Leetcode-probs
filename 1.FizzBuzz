class Solution {
public:
    vector<string> fizzBuzz(int n) {
        vector<string> f;
        int i;
        for(int i=1;i<=n;i++){
        if(i%3==0 && i%5==0){
                f.push_back("FizzBuzz");
        }
        else if(i%3==0){
            f.push_back("Fizz");
        }
        else if(i%5==0){
            f.push_back("Buzz");
        }
        else{
            f.push_back(to_string(i));
        }
        }
        for(int i=1;i<=n;i++){
            cout<<"""<<f(i)<<"""<<",";
        }
        return f;
    }
};
